# ─── Dados sensíveis ────────────────────────────────────────────────
# Hashes de senha, contas e o segredo que assina os tokens HMAC.
# O servidor recria essa pasta sozinho na primeira execução.
servidor/dados/
*.tmp

# ─── Variáveis de ambiente e credenciais ────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
segredo.txt

# ─── Dependências ───────────────────────────────────────────────────
node_modules/
package-lock.json.bak
.npm/
.yarn/
.pnp.*

# ─── Build e saída ──────────────────────────────────────────────────
dist/
build/
out/
coverage/
.cache/

# ─── Logs ───────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Editor e IDE ───────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ─── Ferramentas locais ─────────────────────────────────────────────
.claude/settings.local.json

# ─── Sistema operacional ────────────────────────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
